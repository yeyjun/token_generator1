<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TokenGenerator.CaesarCipherPage"
             Title="Cipher"
             Padding="0">

    <Grid>
        <Editor
            x:Name="NotesEditor"
            Placeholder="Type here..."
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

        <VerticalStackLayout
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,10,10"
            Spacing="5">
            <Label
                x:Name="StatusLabel"
                TextColor="Gray"
                HorizontalTextAlignment="End"
                BackgroundColor="#CCFFFFFF" />
            <Button
                x:Name="SaveButton"
                Text="&#128190;"
                FontSize="20"
                WidthRequest="44"
                HeightRequest="44"
                CornerRadius="22"
                Padding="0"
                Clicked="OnSaveClicked" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
