<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TokenGenerator.CipherGamePage"
             Title="Game">

    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="20">

            <Label
                Text="Word Puzzle"
                Style="{StaticResource Headline}"
                HorizontalOptions="Center" />
            <Label
                Text="Guess the hidden word one letter at a time."
                HorizontalTextAlignment="Center" />

            <Label
                x:Name="WordDisplayLabel"
                FontSize="28"
                FontFamily="OpenSansSemibold"
                HorizontalTextAlignment="Center"
                HorizontalOptions="Center" />

            <Label
                x:Name="AttemptsLabel"
                Text="Attempts left: 6"
                HorizontalTextAlignment="Center" />

            <Label
                x:Name="GuessedLettersLabel"
                Text="Guessed: "
                HorizontalTextAlignment="Center"
                TextColor="Gray" />

            <Entry
                x:Name="LetterEntry"
                Placeholder="Enter a letter"
                MaxLength="1"
                HorizontalTextAlignment="Center" />

            <Button
                x:Name="GuessButton"
                Text="Guess Letter"
                Clicked="OnGuessClicked"
                HorizontalOptions="Fill" />

            <Label
                x:Name="FeedbackLabel"
                HorizontalTextAlignment="Center"
                FontAttributes="Bold" />

            <Label
                x:Name="ScoreLabel"
                Text="Score: 0"
                HorizontalTextAlignment="Center"
                TextColor="Gray" />

            <Button
                x:Name="NewWordButton"
                Text="New Word"
                Clicked="OnNewWordClicked"
                HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
