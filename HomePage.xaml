<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TokenGenerator.HomePage"
             Title="Home"
             BackgroundColor="White">

    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
        <WebView x:Name="PenguinWebView" HeightRequest="140" WidthRequest="140" BackgroundColor="Transparent" />
        <Label x:Name="TitleLabel" Text="BrewCode Admin" FontFamily="OpenSansSemibold" FontSize="20" TextColor="#3F2E22" HorizontalOptions="Center" />

        <VerticalStackLayout Spacing="4" Margin="0,12,0,0">
            <Label x:Name="DateTimeLabel" TextColor="#3F2E22" FontSize="14" HorizontalOptions="Center" />
            <Label x:Name="LocationLabel" Text="Location: locating..." TextColor="#6E6E6E" FontSize="14" HorizontalOptions="Center" />
            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label x:Name="WeatherIconLabel" Text="⏳" FontSize="24" VerticalOptions="Center" />
                <Label x:Name="WeatherTempLabel" TextColor="#6E6E6E" FontSize="14" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <Border
            x:Name="MysteryCard"
            Margin="0,16,0,0"
            Padding="16,14"
            WidthRequest="280"
            BackgroundColor="#F3E7DA"
            StrokeShape="RoundRectangle 14"
            Stroke="#E3C9AC"
            StrokeThickness="1">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMysteryCardTapped" />
            </Border.GestureRecognizers>
            <VerticalStackLayout Spacing="6">
                <Label x:Name="MysteryHeaderLabel" Text="🌹 Mystery of the Day" FontFamily="OpenSansSemibold" FontSize="13" TextColor="#8B6A52" HorizontalOptions="Center" />
                <Label x:Name="MysterySetLabel" FontFamily="OpenSansSemibold" FontSize="15" TextColor="#3F2E22" HorizontalOptions="Center" />
                <Label x:Name="MysteryListLabel" FontSize="12" TextColor="#6E6E6E" LineBreakMode="WordWrap" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>

</ContentPage>
