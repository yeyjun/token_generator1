<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TokenGenerator.LETReviewerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="LET Reviewer">

    <Grid Padding="20">

        <!-- Setup screen -->
        <VerticalStackLayout x:Name="SetupLayout" Spacing="16" VerticalOptions="Center">
            <Label Text="LET Reviewer" FontAttributes="Bold" FontSize="22" HorizontalOptions="Center" />
            <Label Text="Pick a category and test yourself." FontSize="13" TextColor="Gray" HorizontalOptions="Center" />

            <Picker x:Name="CategoryPicker" Title="Category" HorizontalOptions="Fill" />

            <Button Text="Start Quiz" Clicked="OnStartClicked" HorizontalOptions="Center" WidthRequest="180" />
        </VerticalStackLayout>

        <!-- Quiz screen -->
        <VerticalStackLayout x:Name="QuizLayout" Spacing="14" IsVisible="False">
            <Label x:Name="ProgressLabel" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />

            <Label x:Name="QuestionLabel" FontSize="17" FontAttributes="Bold" />

            <VerticalStackLayout x:Name="ChoicesLayout" Spacing="8" />

            <Label x:Name="FeedbackLabel" FontSize="13" IsVisible="False" />

            <Button x:Name="NextButton" Text="Next" Clicked="OnNextClicked" IsVisible="False" HorizontalOptions="Center" WidthRequest="140" />
        </VerticalStackLayout>

        <!-- Result screen -->
        <VerticalStackLayout x:Name="ResultLayout" Spacing="14" VerticalOptions="Center" IsVisible="False">
            <Label Text="Quiz Complete" FontAttributes="Bold" FontSize="20" HorizontalOptions="Center" />
            <Label x:Name="ScoreLabel" FontSize="16" HorizontalOptions="Center" />
            <Button Text="Try Again" Clicked="OnRetryClicked" HorizontalOptions="Center" WidthRequest="160" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
