<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TokenGenerator.NoteDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Note">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <HorizontalStackLayout Spacing="8">
                <BoxView x:Name="ColorSwatch" WidthRequest="14" HeightRequest="14" CornerRadius="7" />
                <Label x:Name="PinnedLabel" Text="&#11088; Pinned" FontSize="12" TextColor="Gray" IsVisible="False" />
            </HorizontalStackLayout>
            <Label x:Name="TitleLabel" FontSize="24" FontAttributes="Bold" />
            <Label x:Name="DateLabel" FontSize="12" TextColor="Gray" />
            <Label x:Name="ReminderLabel" FontSize="12" TextColor="DarkOrange" IsVisible="False" />
            <BoxView HeightRequest="1" Color="LightGray" Margin="0,8" />
            <WebView x:Name="ContentWebView" HeightRequest="60" Navigated="OnContentWebViewNavigated" />

            <HorizontalStackLayout Spacing="10" Margin="0,20,0,0">
                <Button Text="Edit" Clicked="OnEditClicked" />
                <Button Text="Delete" Clicked="OnDeleteClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
