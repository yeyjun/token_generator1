<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TokenGenerator.NoteEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Note">

    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="PinToolbarItem" Text="&#9734;" Clicked="OnPinClicked" />
        <ToolbarItem Text="&#9881;" Clicked="OnSettingsClicked" />
        <ToolbarItem Text="Save" Clicked="OnSaveClicked" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <Style x:Key="RibbonButtonStyle" TargetType="Button">
            <Setter Property="WidthRequest" Value="42" />
            <Setter Property="HeightRequest" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="TextColor" Value="#334155" />
            <Setter Property="BorderColor" Value="#E2E8F0" />
            <Setter Property="BorderWidth" Value="1" />
        </Style>
    </ContentPage.Resources>

    <Grid Padding="20" RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <Entry
            x:Name="TitleEntry"
            Grid.Row="0"
            Placeholder="Title"
            FontSize="20"
            FontAttributes="Bold" />

        <WebView
            x:Name="ContentWebView"
            Grid.Row="1"
            VerticalOptions="Fill" />

        <!-- Collapsible composition ribbon -->
        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Border StrokeShape="RoundRectangle 10" Stroke="#E2E8F0" BackgroundColor="#F8FAFC" Padding="12,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRibbonToggleTapped" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="8">
                    <Label x:Name="RibbonToggleIcon" Text="&#9662;" FontSize="12" TextColor="#64748B" VerticalOptions="Center" />
                    <Label Text="Format" FontSize="12" FontAttributes="Bold" TextColor="#334155" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <ScrollView x:Name="RibbonToolsScroll" Orientation="Horizontal" IsVisible="False">
                <HorizontalStackLayout Spacing="8">
                    <Button Text="B" FontAttributes="Bold" Style="{StaticResource RibbonButtonStyle}" Clicked="OnBoldClicked" />
                    <Button Text="I" FontAttributes="Italic" Style="{StaticResource RibbonButtonStyle}" Clicked="OnItalicClicked" />
                    <Button Text="U" Style="{StaticResource RibbonButtonStyle}" Clicked="OnUnderlineClicked" />
                    <Button Text="&#8226;" Style="{StaticResource RibbonButtonStyle}" Clicked="OnBulletClicked" />
                    <Button Text="&#9744;" Style="{StaticResource RibbonButtonStyle}" Clicked="OnChecklistClicked" />
                    <Button Text="H" Style="{StaticResource RibbonButtonStyle}" Clicked="OnHeadingClicked" />
                    <Button Text="&#9472;" Style="{StaticResource RibbonButtonStyle}" Clicked="OnDividerClicked" />
                    <Button Text="&#128337;" Style="{StaticResource RibbonButtonStyle}" Clicked="OnTimestampClicked" />
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
