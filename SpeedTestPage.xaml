<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TokenGenerator.SpeedTestPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Speed Test">

    <VerticalStackLayout Padding="24" Spacing="18" VerticalOptions="Center">

        <Label Text="Network Speed Test" FontAttributes="Bold" FontSize="20" HorizontalOptions="Center" />

        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <Border Grid.Column="0" Padding="12" StrokeShape="RoundRectangle 10" Stroke="#E2E8F0">
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="PING" FontSize="10" TextColor="Gray" HorizontalOptions="Center" />
                    <Label x:Name="PingLabel" Text="—" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label Text="ms" FontSize="11" TextColor="Gray" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Padding="12" StrokeShape="RoundRectangle 10" Stroke="#E2E8F0">
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="DOWNLOAD" FontSize="10" TextColor="Gray" HorizontalOptions="Center" />
                    <Label x:Name="DownloadLabel" Text="—" FontSize="18" FontAttributes="Bold" TextColor="#16A34A" HorizontalOptions="Center" />
                    <Label Text="Mbps" FontSize="11" TextColor="Gray" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" Padding="12" StrokeShape="RoundRectangle 10" Stroke="#E2E8F0">
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="UPLOAD" FontSize="10" TextColor="Gray" HorizontalOptions="Center" />
                    <Label x:Name="UploadLabel" Text="—" FontSize="18" FontAttributes="Bold" TextColor="#7C3AED" HorizontalOptions="Center" />
                    <Label Text="Mbps" FontSize="11" TextColor="Gray" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <ProgressBar x:Name="TestProgressBar" Progress="0" />

        <Label x:Name="StatusLabel" Text="Tap Start to test your connection." FontSize="12" TextColor="Gray" HorizontalOptions="Center" HorizontalTextAlignment="Center" />

        <Button x:Name="StartButton" Text="Start Test" Clicked="OnStartClicked" WidthRequest="160" HorizontalOptions="Center" />

    </VerticalStackLayout>

</ContentPage>
