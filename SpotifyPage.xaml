<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TokenGenerator.SpotifyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Spotify">

    <Grid Padding="16" RowDefinitions="*,Auto" RowSpacing="10">

        <!-- Connect screen -->
        <VerticalStackLayout
            x:Name="ConnectLayout"
            Grid.Row="0"
            Spacing="14"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            IsVisible="False">
            <Label Text="Connect to Spotify" FontAttributes="Bold" FontSize="20" HorizontalOptions="Center" />
            <Label
                Text="Sign in with your Spotify account to search tracks and control playback."
                FontSize="13"
                TextColor="Gray"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                WidthRequest="260" />
            <Button
                x:Name="ConnectButton"
                Text="Connect"
                Clicked="OnConnectClicked"
                WidthRequest="160"
                HorizontalOptions="Center"
                BackgroundColor="#1DB954"
                TextColor="White" />
            <Label x:Name="ConnectStatusLabel" FontSize="12" TextColor="#DC2626" HorizontalOptions="Center" HorizontalTextAlignment="Center" WidthRequest="260" IsVisible="False" />
        </VerticalStackLayout>

        <!-- Main screen -->
        <Grid x:Name="MainLayout" Grid.Row="0" RowDefinitions="Auto,*" RowSpacing="10" IsVisible="False">
            <SearchBar Grid.Row="0" x:Name="SearchBox" Placeholder="Search for a song..." SearchButtonPressed="OnSearchPressed" />

            <CollectionView Grid.Row="1" x:Name="ResultsList">
                <CollectionView.EmptyView>
                    <Label Text="Search for a track to get started." TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="6" ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                            <Image Grid.Column="0" Source="{Binding AlbumImageUrl}" WidthRequest="44" HeightRequest="44" Aspect="AspectFill" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="14" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Artists}" FontSize="12" TextColor="Gray" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Button
                                Grid.Column="2"
                                Text="Play"
                                FontSize="12"
                                Padding="10,4"
                                VerticalOptions="Center"
                                Clicked="OnPlayTrackClicked" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Now playing bar -->
        <Border Grid.Row="1" x:Name="NowPlayingBar" Padding="12" StrokeShape="RoundRectangle 12" Stroke="#E2E8F0" IsVisible="False">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label x:Name="NowPlayingTitle" FontAttributes="Bold" FontSize="13" LineBreakMode="TailTruncation" />
                    <Label x:Name="NowPlayingArtist" FontSize="11" TextColor="Gray" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="⏮" FontSize="16" Clicked="OnPreviousClicked" WidthRequest="44" />
                <Button Grid.Column="2" x:Name="PlayPauseButton" Text="⏸" FontSize="16" Clicked="OnPlayPauseClicked" WidthRequest="44" />
                <Button Grid.Column="3" Text="⏭" FontSize="16" Clicked="OnNextClicked" WidthRequest="44" />
            </Grid>
        </Border>

    </Grid>
</ContentPage>
